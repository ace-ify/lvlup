/T (CREATE OR REPLACE FUNCTION dept_max_sal_emp1\(dept_name VARCHAR\) RETURNS TABLE\(emp_id INT, fname VARCHAR, salary NUMERIC\)  AS $$ BEGIN     RETURN QUERY     SELECT          e.emp_id,  e.fname, e.salary     FROM          employees e     WHERE          e.dept = dept_name         AND e.salary = \(             SELECT MAX\(emp.salary\)             FROM employees emp             WHERE emp.dept = dept_name         \); END; $$ LANGUAGE plpgsql;)
/E (CREATE OR REPLACE FUNCTION dept_max_sal_emp1\(dept_name VARCHAR\) RETURNS TABLE\(emp_id INT, fname VARCHAR, salary NUMERIC\)  AS $$ BEGIN     RETURN QUERY     SELECT          e.emp_id,  e.fname, e.salary     FROM          employees e     WHERE          e.dept = dept_name         AND e.salary = \(             SELECT MAX\(emp.salary\)             FROM employees emp             WHERE emp.dept = dept_name         \); END; $$ LANGUAGE plpgsql;)
/Pg 230 0 R
/K [0]
